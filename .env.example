# Copy to .env and fill in your real value.
#
# How to obtain the cookie:
#   1. Log in at https://www.codingame.com in your browser.
#   2. Open DevTools (F12) -> Application (Chrome) / Storage (Firefox) -> Cookies
#      -> https://www.codingame.com
#   3. Copy the VALUE of the "rememberMe" cookie and paste it below.
#
# The cookie is long-lived but will eventually expire; refresh it when login
# verification starts failing.
CODINGAME_REMEMBER_ME=your-remember-me-cookie-value-here

# Optional: expose the write tools (run_puzzle_tests, submit_puzzle_solution).
# Read-only by default. Truthy values: 1 / true / yes / on.
# NOTE: submit_puzzle_solution performs a real submission that affects your score.
# CODINGAME_ENABLE_WRITES=1
